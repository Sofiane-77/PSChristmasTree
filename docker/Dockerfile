FROM mcr.microsoft.com/powershell:7.4-ubuntu-22.04

COPY PSChristmasTree/ /usr/local/share/powershell/Modules/PSChristmasTree/

HEALTHCHECK --interval=30s --timeout=10s --retries=1 \
	CMD pwsh -NoProfile -Command "Import-Module PSChristmasTree; Get-PSChristmasTreeConfig" || exit 1

# Run the application
CMD ["pwsh", "-NoLogo", "-NoProfile", "-NoExit", "-Command", "Show-PSChristmasTree; Write-Host ''; Write-Host '  PSChristmasTree - Interactive help' -ForegroundColor Green; Write-Host '  ---------------------------------' -ForegroundColor Green; Write-Host ''; Write-Host '  QUICK START' -ForegroundColor Green; Write-Host '  Show the tree again       ' -NoNewline -ForegroundColor Gray; Write-Host 'Show-PSChristmasTree' -ForegroundColor Cyan; Write-Host '  See command examples      ' -NoNewline -ForegroundColor Gray; Write-Host 'Get-Help Show-PSChristmasTree -Examples' -ForegroundColor Cyan; Write-Host '  View all parameters       ' -NoNewline -ForegroundColor Gray; Write-Host 'Get-Help Show-PSChristmasTree -Full' -ForegroundColor Cyan; Write-Host ''; Write-Host '  COLORS' -ForegroundColor Green; Write-Host '  Single mode colors the tree with -SingleColor.' -ForegroundColor Gray; Write-Host '  The trunk is red by default; change it with -TrunkColor.' -ForegroundColor DarkYellow; Write-Host '  One color for tree + trunk ' -NoNewline -ForegroundColor Gray; Write-Host 'Show-PSChristmasTree -ColorMode Single -SingleColor Green -TrunkColor Green' -ForegroundColor Yellow; Write-Host ''; Write-Host '  CONFIGURATION' -ForegroundColor Green; Write-Host '  Save settings              ' -NoNewline -ForegroundColor Gray; Write-Host 'Set-PSChristmasTreeConfig' -ForegroundColor Cyan; Write-Host '  View current settings      ' -NoNewline -ForegroundColor Gray; Write-Host 'Get-PSChristmasTreeConfig' -ForegroundColor Cyan; Write-Host '  Reset saved settings       ' -NoNewline -ForegroundColor Gray; Write-Host 'Reset-PSChristmasTreeConfig' -ForegroundColor Cyan; Write-Host ''; Write-Host '  Type ' -NoNewline -ForegroundColor Gray; Write-Host 'exit' -NoNewline -ForegroundColor Magenta; Write-Host ' to quit.' -ForegroundColor Gray; Write-Host ''"]